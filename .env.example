# RiskLens — local demonstration configuration only.
# Copy to .env and adjust if needed. Never put a real secret, API key,
# gateway credential, or production connection string in this file or in
# .env. No external integration is required to run this project -- the two
# GCP_* vars below are strictly optional (see SECURITY.md's "Optional
# external dependency" section) and everything else runs fully offline.

APP_ENV=development
APP_NAME=RiskLens

# Must match app/db/database.py::DEFAULT_DATABASE_URL, otherwise the app
# will silently open a different (empty) database and show zero cases.
DATABASE_URL=sqlite:///./clearrisk_recover.db

MODEL_ENABLED=true
RULES_ONLY_FALLBACK=true
SYNTHETIC_DATA_SEED=42
LOG_LEVEL=INFO

# Local FastAPI base URL used by the Streamlit dashboard.
CLEARRISK_API_BASE_URL=http://127.0.0.1:8000

# Optional, dashboard-only: enables case_detail.py's live Vertex AI (Gemini)
# evidence-analysis call. Leave both unset to use the dashboard's normal,
# clearly-labeled illustrative fallback -- nothing else in this project
# needs these. If you do set GCP_CREDENTIALS_JSON, treat it as a real
# production secret (see SECURITY.md), never commit it, and never put the
# actual value in this .example file.
# GCP_PROJECT_ID=
# GCP_CREDENTIALS_JSON=
